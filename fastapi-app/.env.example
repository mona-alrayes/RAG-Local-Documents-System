# Deployment mode: cloud | local
RAG_DEPLOYMENT_MODE=local

# Shared secret used by trusted internal clients.
# Replace this value in the real environment.
INTERNAL_API_KEY=change-me
LARAVEL_INTERNAL_BASE_URL=http://localhost:8000
PROCESSING_CALLBACK_SECRET=change-me-different-from-internal-api-key
PROCESSING_CALLBACK_TIMEOUT_SECONDS=5
PROCESSING_CALLBACK_MAX_ATTEMPTS=3
PROCESSING_CALLBACK_RETRY_DELAY_SECONDS=0.25

# Required only when RAG_DEPLOYMENT_MODE=local.
# Remove or comment this setting when using cloud mode.
LOCAL_AI_TOPOLOGY=host_native
# resolver choose [CUDA , ROCm , XPU , MPS , CPU]
LOCAL_DEVICE=auto
# Accelator = FP16 , CPU = FP32
LOCAL_DTYPE=auto
# Qdrant connection and processing collections.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_CLOUD_COLLECTION=rag_documents_cloud
QDRANT_HYBRID_LOCAL_COLLECTION=rag_documents_hybrid_local


# LlamaParse Cloud API key used for document parsing.
LLAMA_CLOUD_API_KEY=

CHUNK_SIZE=800
CHUNK_OVERLAP=80

# Jina AI API key used for cloud embeddings and reranking.
JINAAI_API_KEY=

# Cloud dense embedding model.
CLOUD_EMBED_MODEL=jina-embeddings-v3

# Cloud multilingual reranker model.
CLOUD_RERANK_MODEL=jina-reranker-v2-base-multilingual

# Cloud embedding batching and retry controls.
EMBED_BATCH_SIZE=6
WAIT_BETWEEN_BATCHES=3
RATE_LIMIT_RETRY_WAIT=30
MAX_RETRIES=5

LOCAL_EMBED_MODEL=BAAI/bge-m3
LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Local heavy-model lifecycle safeguards.
LOCAL_MIN_AVAILABLE_MEMORY_RATIO=0.15
LOCAL_AI_MAX_CONCURRENCY=1
